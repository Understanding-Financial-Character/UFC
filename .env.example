APP_ENV=local
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=ufc
POSTGRES_USER=ufc
POSTGRES_PASSWORD=ufc
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ufc:ufc@localhost:5432/ufc

BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

LLM_API_KEY=

# Local development examples only. Generate new values for non-local use.
# Generate AUTH_TOKEN_SECRET and FIELD_LOOKUP_HMAC_KEY with:
# openssl rand -base64 32
# Generate FIELD_ENCRYPTION_KEY with:
# openssl rand -base64 32
AUTH_TOKEN_SECRET=
FIELD_ENCRYPTION_KEY=
FIELD_LOOKUP_HMAC_KEY=
FIELD_KEY_VERSION=local-v1
