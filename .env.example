# Application
APP_ENV=local
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database
POSTGRES_DB=ufc
POSTGRES_USER=ufc
POSTGRES_PASSWORD=ufc
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ufc:ufc@db:5432/ufc

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Security
# Generate AUTH_TOKEN_SECRET and FIELD_LOOKUP_HMAC_KEY with: openssl rand -base64 32
# Generate FIELD_ENCRYPTION_KEY with: openssl rand -base64 32
AUTH_TOKEN_SECRET=
FIELD_ENCRYPTION_KEY=
FIELD_LOOKUP_HMAC_KEY=
FIELD_KEY_VERSION=local-v1

# LLM
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:4b
LLM_THINKING_ENABLED=false
LLM_API_KEY=
